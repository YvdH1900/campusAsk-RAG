# ================================================
# CampusAsk-RAG Docker Compose 环境变量（模板）
# ================================================
# 复制为 .env 并填入真实值后，docker-compose 启动时
# 会自动读取此文件做 ${VAR} 变量替换。
#
# 用法: cp .env.example .env
# ================================================
#
# ⚠️ 以下字段与 backend/.env 共享，两边保持一致：
#    MYSQL_ROOT_PASSWORD、DASHSCOPE_API_KEY、SECRET_KEY、
#    ENABLE_API_DOCS、DEFAULT_ADMIN_PASSWORD
# ================================================

# MySQL root 密码
MYSQL_ROOT_PASSWORD=your-mysql-root-password

# Redis 密码
REDIS_PASSWORD=your-redis-password

# RabbitMQ 账号密码
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=your-rabbitmq-password

# MinIO 对象存储（Milvus 依赖，默认 minioadmin/minioadmin）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 通义千问 API 密钥
DASHSCOPE_API_KEY=

# LLM 模型配置
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# JWT 签名密钥（openssl rand -hex 32）
SECRET_KEY=your-secret-key-change-me

# API 文档开关（生产环境 false）
ENABLE_API_DOCS=false

# 默认管理员密码
DEFAULT_ADMIN_PASSWORD=
