# ================================================
# CampusAsk-RAG 后端环境配置（模板）
# ================================================
# 复制此文件为 .env 并根据实际环境修改
# 所有配置项都有默认值，开发环境可直接使用默认值
# 生产环境请务必修改敏感配置（SECRET_KEY、数据库密码等）
#
# Docker 部署时，此文件的值会被 docker-compose 注入的
# 环境变量覆盖（docker-compose 从根目录 .env 读取）。
# ================================================

# ================================================
# 数据库配置
# ================================================
# DATABASE_URL 由以下组件自动拼接，一般无需手动设置
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=your-mysql-root-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=campus_ask_rag

REDIS_URL=redis://localhost:6379/0

# ================================================
# 向量数据库配置
# ================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ================================================
# LLM 配置
# ================================================
# 通义千问 API 密钥（必须配置）
# 获取地址: https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=

LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4

# ================================================
# 安全配置
# ================================================
# JWT 加密密钥，生产环境用 openssl rand -hex 32 生成
SECRET_KEY=your-secret-key-change-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=30

# 默认管理员密码（不设置则自动生成随机密码）
DEFAULT_ADMIN_PASSWORD=

# ================================================
# Celery 配置
# ================================================
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_RESULT_EXPIRES=3600
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_DELAY=60

# ================================================
# 缓存配置
# ================================================
CACHE_TTL=3600

# ================================================
# 服务器配置
# ================================================
ALLOWED_ORIGINS=["http://localhost:5173"]

# ⚠️ 生产环境设为 false 以禁用 Swagger/ReDoc
ENABLE_API_DOCS=true
